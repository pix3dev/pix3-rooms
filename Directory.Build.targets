<Project>

  <!-- Hot-path server settings: Server GC + concurrent, DATAS off.

       These live in a .targets file, NOT in Directory.Build.props, on purpose. Props are imported
       before the SDK, where $(OutputType) is still empty, so the same PropertyGroup conditioned on
       'Exe' in Directory.Build.props evaluates to false and silently does nothing — the published
       runtimeconfig.json then carries Server GC (an ASP.NET Core SDK default) with DATAS still ON,
       which is precisely the configuration docs/architecture.md rules out. Targets are imported
       after the SDK, so the condition here sees a real OutputType.

       DATAS ships ENABLED by default with Server GC since .NET 9. It starts at one heap and ramps
       reactively, scheduling full compacting GCs as it adapts — measured 1.16-1.69x regressions on
       latency-sensitive workloads (dotnet/runtime#109047). A fixed-tick game server wants stable
       p99 over a small RSS, so it is switched off deliberately.

       Test projects are excluded: xunit v3 makes them OutputType=Exe too, and the test host's GC
       mode is nobody's contract. Verify with:
         dotnet msbuild src/Pix3.Rooms.Server/Pix3.Rooms.Server.csproj -getProperty:GarbageCollectionAdaptationMode
       and by grepping System.GC.DynamicAdaptationMode in the published runtimeconfig.json. -->
  <PropertyGroup Condition="'$(OutputType)' == 'Exe' AND '$(IsTestProject)' != 'true'">
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <GarbageCollectionAdaptationMode>0</GarbageCollectionAdaptationMode>
  </PropertyGroup>

  <!-- Refuse to publish while a licence file still carries an unresolved placeholder.

       The copyright holder in LICENSE / NOTICE is a public assertion of ownership, and it is
       deliberately left as a marker until ownership has actually been settled (see CONTRIBUTING.md).
       This target exists so that "we'll fill it in later" cannot quietly become "we shipped it with
       a placeholder".

       It runs on Publish, not on Build: an inner-loop `dotnet build` or `dotnet test` should not be
       blocked by an open legal question, but nothing may leave the machine with markers in it.
       To bypass for a deliberate local publish: -p:AllowTbdCopyright=true -->
  <Target Name="CheckCopyrightPlaceholders"
          BeforeTargets="Publish"
          Condition="'$(AllowTbdCopyright)' != 'true'">
    <PropertyGroup>
      <_RepoRoot>$(MSBuildThisFileDirectory)</_RepoRoot>
      <_LicRoot>$(_RepoRoot)LICENSE</_LicRoot>
      <_LicNotice>$(_RepoRoot)NOTICE</_LicNotice>
      <_LicProtocol>$(_RepoRoot)src/Pix3.Rooms.Protocol/LICENSE</_LicProtocol>
      <_LicLoadGen>$(_RepoRoot)tools/Pix3.Rooms.LoadGen/LICENSE</_LicLoadGen>
    </PropertyGroup>

    <Error Condition="!Exists('$(_LicRoot)')" Text="Licence file is missing: $(_LicRoot)" />
    <Error Condition="!Exists('$(_LicNotice)')" Text="Licence file is missing: $(_LicNotice)" />
    <Error Condition="!Exists('$(_LicProtocol)')" Text="Licence file is missing: $(_LicProtocol)" />
    <Error Condition="!Exists('$(_LicLoadGen)')" Text="Licence file is missing: $(_LicLoadGen)" />

    <!-- Read each file into its own property and concatenate. Item batching with %(FullPath) is not
         usable inside a PropertyGroup (MSB4095), hence the explicit spelling. -->
    <PropertyGroup>
      <_LicenceText>$([System.IO.File]::ReadAllText('$(_LicRoot)'))$([System.IO.File]::ReadAllText('$(_LicNotice)'))$([System.IO.File]::ReadAllText('$(_LicProtocol)'))$([System.IO.File]::ReadAllText('$(_LicLoadGen)'))</_LicenceText>
    </PropertyGroup>

    <Error Condition="$(_LicenceText.Contains('__COPYRIGHT_HOLDER_TBD__')) or $(_LicenceText.Contains('__CONTACT_EMAIL_TBD__'))"
           Text="Licence files still contain an unresolved placeholder (__COPYRIGHT_HOLDER_TBD__ / __CONTACT_EMAIL_TBD__). The copyright holder has not been settled — see CONTRIBUTING.md. Resolve the markers, or publish with -p:AllowTbdCopyright=true to bypass deliberately." />
  </Target>

</Project>
