{
  // Every key the server reads is written out with its current code default, so the whole
  // configuration surface is visible without reading the option classes. The JSON configuration
  // provider skips comments, so these annotations are safe.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Pix3.Rooms": "Information"
    }
  },
  "AllowedHosts": "*",
  "Metrics": {
    "Path": "/metrics",
    // The scrape endpoint is normally reachable only from the cluster's scrape network, but it also
    // reports room ids and player counts, so it is guarded by default here.
    "RequireServiceToken": true,
    "MaxSeriesPerMetric": 64
  },
  "Rooms": {
    "Server": {
      "MaxRooms": 256,
      "MaxTotalConnections": 4096,
      // Bound by BOTH NetOptions (default 1024) and RoomServerOptions (default 4096). It is written
      // explicitly so the two views of the same key can never silently disagree; 4096 is the room
      // queue's own default and the value that matters for back-pressure.
      "InboundQueueCapacity": 4096,
      "OutboundQueueCapacity": 256,
      "HandshakeTimeoutSeconds": 10,
      "MaxConsecutiveProtocolErrors": 16,
      // Only enable behind a proxy you own: the header is otherwise attacker-controlled and would
      // defeat the per-IP connection cap.
      "TrustForwardedHeaders": false,
      "MaxDrainPerTick": 2048,
      "MaxFrameBytes": 16384,
      "MaxSnapshotFramesPerTick": 8,
      "MaxConsecutiveTickFailures": 5,
      "IdleSweepIntervalSeconds": 15,
      "RoomCreationGraceSeconds": 30,
      "MaxChatPerMinute": 20,
      "MaxChatLength": 512,
      "RestrictRoomVarsToHost": true,
      "MaxRoomVars": 64,
      "MaxRoomVarKeyLength": 64,
      "MaxRoomVarValueBytes": 4096,
      "MaxColdPropsBytes": 4096,
      "MaxEntitiesPerOwner": 256,
      "MaxRemoteEventNameLength": 64,
      "MaxRemoteEventPayloadBytes": 4096,
      "TickHistogramWindowSeconds": 10,
      "ShutdownTimeoutSeconds": 5
    },
    "Quotas": {
      "MaxConnectionsPerIp": 8,
      "MaxMessagesPerSecond": 120,
      "MaxBytesPerSecond": 262144,
      "MaxPayloadBytes": 16384,
      "MaxEntityUpdatesPerFrame": 64,
      "MaxSpawnsPerMinute": 120,
      "IdleTimeoutSeconds": 60,
      "MaxChatPerMinute": 30
    },
    "Auth": {
      "Mode": "Jwt",
      // Deliberately empty: startup validation refuses to run in Jwt mode without it, which forces the
      // operator to supply it out-of-band (Rooms__Auth__JwtSecret, user secrets, or a secret store).
      // Minimum 32 bytes for HS256.
      "JwtSecret": "",
      "Issuer": "pix3-cloud",
      "Audience": "pix3-rooms",
      "ClockSkewSeconds": 60,
      // Empty means the admin API denies every request — never "allows everything". Startup fails in
      // Production without it; supply it as Rooms__Auth__ServiceToken.
      "ServiceToken": ""
    },
    "Defaults": {
      "MaxPlayers": 64,
      "TickHz": 20,
      "AoiRadius": 1200,
      "IdleTtlSeconds": 300,
      "MaxEntities": 4096,
      "Mode": "Relay"
    }
  }
}
