{
  // Every key documented in docs/architecture.md -> Configuration is written out here at its documented
  // default, so the whole surface is visible without reading the option classes. The JSON configuration
  // provider skips comments, so these annotations are safe.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Pix3.Rooms": "Information"
    }
  },
  "AllowedHosts": "*",
  "Metrics": {
    "Path": "/metrics",
    // The scrape endpoint is normally reachable only from the cluster's scrape network, but it also
    // reports room ids and player counts, so it is guarded by default here.
    "RequireServiceToken": true,
    "MaxSeriesPerMetric": 64
  },
  "Rooms": {
    // Server-wide rails. One section, three binders: NetOptions takes the transport keys,
    // RoomServerOptions the room keys and ReplicationTuningOptions the five replication keys.
    // Configuration binding ignores keys a type does not declare, which is what lets them share it.
    "Server": {
      "MaxRooms": 256,
      "MaxTotalConnections": 4096,
      // Kestrel's own cap on upgraded connections, applied by the composition root. Kestrel's default is
      // unlimited, which is not a policy; this is the backstop behind MaxTotalConnections.
      "MaxConcurrentUpgradedConnections": 4096,
      // Bound by BOTH NetOptions (default 1024) and RoomServerOptions (default 4096). It is written
      // explicitly so the two views of the same key can never silently disagree; 4096 is the room
      // queue's own default and the value that matters for back-pressure.
      "InboundQueueCapacity": 4096,
      // A full control lane closes the connection (a control frame has no later frame that repairs it),
      // so it is deep. A full hot lane only means resync, so it is shallow: a deep hot queue buffers
      // staleness, and by the tenth queued delta a fresh snapshot would have been cheaper.
      "OutboundControlQueueCapacity": 64,
      "OutboundHotQueueCapacity": 8,
      // Two seconds, not ten: a pre-auth socket holds a buffer and a connection slot having proved
      // nothing, and a real client sends its hello in the same round trip as the upgrade.
      "HandshakeTimeoutSeconds": 2,
      "MaxPreAuthFrameBytes": 2048,
      "MaxPreAuthConnectionsPerIp": 4,
      "MaxConsecutiveProtocolErrors": 16,
      // Only enable behind a proxy you own: the header is otherwise attacker-controlled and would
      // defeat the per-IP connection cap.
      "TrustForwardedHeaders": false,
      "MaxDrainPerTick": 2048,
      // Control-frame ceiling. Hot frames are bounded far below it by MaxBytesPerClientPerTick.
      "MaxFrameBytes": 16384,
      // Replication rails. One MSS, and one future QUIC datagram.
      "MaxBytesPerClientPerTick": 1100,
      "MaxEntersPerTick": 24,
      // Per-room k-nearest visibility cap. NOTE: the binder for this value is
      // Rooms:Defaults:MaxVisibleEntities (a room carries its own, and WelcomeEvent echoes it); this key
      // is documented in the Rooms:Server table but nothing reads it. Kept for parity with the doc.
      "MaxVisibleEntities": 64,
      // AOI hysteresis: an entity enters at AoiRadius and exits only beyond AoiRadius x this.
      "AoiExitFactor": 1.25,
      // Units/s. Counted, never enforced at Level 1 — 125 units per tick at 20 Hz.
      "MaxEntitySpeed": 2000,
      "MaxSpectatorFocusSpeed": 2000,
      "MaxSnapshotFramesPerTick": 8,
      "MaxConsecutiveTickFailures": 5,
      "IdleSweepIntervalSeconds": 15,
      "RoomCreationGraceSeconds": 30,
      // 0 disables the resume grace, and a drop then leaves with Disconnected.
      "ResumeGraceSeconds": 30,
      // The tick loop spins its tail on a coarse-granularity platform, or above this many players;
      // 0 always spins. 64 idle rooms each burning 4% of a core to spin is a bad trade.
      "SpinTailPlayerThreshold": 32,
      // Per ENTITY; the Rooms:Quotas twin of this name is per connection.
      "MaxColdPropsPerSecond": 2,
      // Room-level; the connection-level twin lives in Rooms:Quotas.
      "MaxChatPerMinute": 10,
      "MaxChatLength": 240,
      "RestrictRoomVarsToHost": true,
      "MaxRoomVars": 64,
      "MaxRoomVarKeyLength": 64,
      "MaxRoomVarValueBytes": 4096,
      "MaxColdPropsBytes": 512,
      "MaxEntitiesPerOwner": 64,
      "MaxSignalNameLength": 64,
      // 255: the hot batch encodes the payload length in one byte, and a bigger payload is not a game
      // event, it is a data channel.
      "MaxSignalPayloadBytes": 255,
      "TickHistogramWindowSeconds": 10,
      "ShutdownTimeoutSeconds": 5
    },
    // Per-connection abuse limits. See docs/protocol.md -> Quota defaults.
    "Quotas": {
      "MaxConnectionsPerIp": 8,
      "MaxMessagesPerSecond": 60,
      "MaxBytesPerSecond": 8192,
      "MaxPayloadBytes": 4096,
      "MaxEntityUpdatesPerFrame": 8,
      "MaxSpawnsPerMinute": 240,
      "MaxSignalsToServerPerSecond": 20,
      "MaxSignalsToAoiPerSecond": 10,
      // The tightest quota in the table, because this one is a 600x amplifier.
      "MaxSignalsToAllPerSecond": 2,
      // Per CONNECTION; the per-entity twin lives in Rooms:Server.
      "MaxColdPropsPerSecond": 2,
      "MaxResyncPerSecond": 2,
      // Soft: counted, never enforced. A respawn genuinely is a discontinuity under client authority.
      "MaxTeleportsPerMinute": 12,
      "IdleTimeoutSeconds": 60,
      "MaxChatPerMinute": 10
    },
    "Auth": {
      "Mode": "Jwt",
      // Deliberately empty: startup validation refuses to run in Jwt mode without it, which forces the
      // operator to supply it out-of-band (Rooms__Auth__JwtSecret, user secrets, or a secret store).
      // Minimum 32 bytes for HS256.
      "JwtSecret": "",
      "Issuer": "pix3-cloud",
      "Audience": "pix3-rooms",
      "ClockSkewSeconds": 60,
      // Empty means the admin API denies every request — never "allows everything". Startup fails in
      // Production without it; supply it as Rooms__Auth__ServiceToken.
      "ServiceToken": "",
      // Cross-site WebSocket hijacking defence, as scheme://host[:port]. An upgrade is not subject to
      // the same-origin policy and carries the browser's cookies, so an empty list lets any page on the
      // internet open an authenticated socket in a visitor's browser: startup FAILS in Production while
      // this is empty. Supply the game's origins, e.g. [ "https://play.example.com" ].
      "AllowedOrigins": []
    },
    // Per-room values substituted when a create request omits them.
    "Defaults": {
      "MaxPlayers": 64,
      "TickHz": 20,
      "AoiRadius": 1200,
      "IdleTtlSeconds": 300,
      "MaxEntities": 4096,
      "MaxVisibleEntities": 64,
      "Mode": "Relay",
      // World bounds every quantized value in a room is expressed against. Set as a whole, never
      // corner-by-corner: a create request that omits worldSize takes all three from here.
      "WorldOriginX": -2048,
      "WorldOriginY": -2048,
      "WorldSize": 4096,
      // Entity kinds a room accepts, as indexes into the build's prefab table. Empty = allow any kind,
      // which startup REFUSES in Production: an unknown kind faults every observer's scene code.
      // Fill this in with the kinds your build can instantiate, e.g. [ 0, 1, 2 ].
      "AllowedKinds": []
    }
  }
}
