{
  // Local development only. Overlays appsettings.json; anything absent here keeps the production value.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Pix3.Rooms": "Debug"
    }
  },
  "Metrics": {
    // Unauthenticated so `curl localhost:5011/metrics` works without a token.
    "RequireServiceToken": false
  },
  "Rooms": {
    "Server": {
      "MaxRooms": 16,
      "MaxTotalConnections": 256,
      "MaxConcurrentUpgradedConnections": 256,
      // A handshake driven by hand (curl, a paused debugger, a bot that logs before it sends) needs more
      // than the production two seconds. It is still a deadline, not an absence of one.
      "HandshakeTimeoutSeconds": 30,
      // Every bot in a local load run shares 127.0.0.1, so the pre-auth per-IP cap has to be generous
      // for the same reason Quotas:MaxConnectionsPerIp is.
      "MaxPreAuthConnectionsPerIp": 256
    },
    "Quotas": {
      // Load-testing from one machine means every bot shares 127.0.0.1, so the per-IP cap has to be
      // generous here — it is the one quota a local run trips for reasons that are not a bug.
      "MaxConnectionsPerIp": 1024
    },
    "Auth": {
      // Accepts unsigned dev:<sub>:<roomId> tokens and refuses to start in Production.
      "Mode": "Insecure",
      "ServiceToken": "dev-service-token"
      // AllowedOrigins is deliberately left at the empty production default: locally the editor may be
      // served from localhost:8123, a file URL or a preview host, and having to enumerate those before
      // the first socket works would be pure friction. Startup warns loudly instead.
    },
    "Defaults": {
      // Left empty on purpose: until the exporter emits a prefab table a dev room must accept whatever
      // kind the scene happens to spawn. Startup warns; only Production refuses.
      "AllowedKinds": []
    }
  }
}
