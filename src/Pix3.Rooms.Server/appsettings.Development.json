{
  // Local development only. Overlays appsettings.json; anything absent here keeps the production value.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Pix3.Rooms": "Debug"
    }
  },
  "Metrics": {
    // Unauthenticated so `curl localhost:5011/metrics` works without a token.
    "RequireServiceToken": false
  },
  "Rooms": {
    "Server": {
      "MaxRooms": 16,
      "MaxTotalConnections": 256
    },
    "Quotas": {
      // Load-testing from one machine means every bot shares 127.0.0.1, so the per-IP cap has to be
      // generous here — it is the one quota a local run trips for reasons that are not a bug.
      "MaxConnectionsPerIp": 1024
    },
    "Auth": {
      // Accepts unsigned dev:<sub>:<roomId> tokens and refuses to start in Production.
      "Mode": "Insecure",
      "ServiceToken": "dev-service-token"
    }
  }
}
