<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pix3.Rooms.Protocol\Pix3.Rooms.Protocol.csproj" />
    <ProjectReference Include="..\..\src\Pix3.Rooms.Server\Pix3.Rooms.Server.csproj" />
    <!-- The load generator's RoomClient is the reference C# client: the end-to-end tests drive the same
         code the load runs drive, so a load number can never come from a client that quietly disagrees
         with the protocol. -->
    <ProjectReference Include="..\..\tools\Pix3.Rooms.LoadGen\Pix3.Rooms.LoadGen.csproj" />
  </ItemGroup>

</Project>