# Copy to /opt/pix3-rooms/shared/rooms.env, fill in the secrets, chmod 600.
# systemd reads this verbatim: no shell expansion, no ${VAR}, quote values containing spaces.
# Every key is the double-underscore override of the matching appsettings path.

ASPNETCORE_ENVIRONMENT=Production
# Loopback only. TLS and the public interface belong to nginx.
ASPNETCORE_URLS=http://127.0.0.1:5011

# --- Identity. Shared with pix3-collab-server: same HS256 secret, scoped audience. ---
Rooms__Auth__Mode=Jwt
Rooms__Auth__JwtSecret=REPLACE-WITH-THE-COLLAB-SERVER-SECRET-MIN-32-BYTES
Rooms__Auth__Issuer=pix3-cloud
Rooms__Auth__Audience=pix3-rooms
Rooms__Auth__ServiceToken=REPLACE-WITH-A-STRONG-RANDOM-TOKEN

# Cross-site WebSocket hijacking defence. Startup FAILS in Production while this is empty.
# Arrays bind by index, so add one line per origin.
#
# These two are also in the repository's appsettings.Production.json, which additionally allows
# http://localhost:8123 (the editor's dev server) at index 2. Keep this file to indexes 0-1: a
# Rooms__Auth__AllowedOrigins__2 line here would SHADOW the localhost entry, and adding origins
# belongs in appsettings.Production.json anyway — an allowlist is not a secret.
Rooms__Auth__AllowedOrigins__0=https://editor.pix3.dev
Rooms__Auth__AllowedOrigins__1=https://cloud.pix3.dev

# --- Mandatory behind a reverse proxy. ---
# Without this every client is 127.0.0.1 as far as the per-IP quotas are concerned, and the
# ninth player in the room is rejected by MaxConnectionsPerIp. Safe to enable only because
# nginx is ours and is the only thing that can reach the loopback port.
Rooms__Server__TrustForwardedHeaders=true

# --- Rails. Startup REFUSES an empty AllowedKinds in Production. ---
# Indexes into the build's prefab table; list the kinds the exported game can instantiate.
Rooms__Defaults__AllowedKinds__0=0

Rooms__Server__MaxRooms=64
